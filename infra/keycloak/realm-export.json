{
  "realm": "ministere",
  "enabled": true,
  "displayName": "Portail Ministériel",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername",
  "roles": {
    "realm": [
      { "name": "AGENT", "description": "Utilisateur final du portail" },
      { "name": "GESTIONNAIRE_HABILITATIONS", "description": "Gère les accès applicatifs" },
      { "name": "ADMIN_PORTAIL", "description": "Administre le portail" },
      { "name": "AUDITEUR_PORTAIL", "description": "Consulte le journal d'audit du portail" }
    ]
  },
  "clients": [
    {
      "clientId": "portail-bff",
      "name": "Portail BFF",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "changer-ce-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/login/oauth2/code/keycloak"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      }
    }
  ],
  "users": [
    {
      "username": "ministre",
      "enabled": true,
      "emailVerified": true,
      "firstName": "La",
      "lastName": "Ministre",
      "email": "ministre@ministere.gouv",
      "credentials": [
        { "type": "password", "value": "Portail-Dev-2026!", "temporary": false }
      ],
      "realmRoles": ["AGENT", "ADMIN_PORTAIL"]
    },
    {
      "username": "agent1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "Un",
      "email": "agent1@ministere.gouv",
      "credentials": [
        { "type": "password", "value": "Portail-Dev-2026!", "temporary": false }
      ],
      "realmRoles": ["AGENT"]
    },
    {
      "username": "auditeur1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Auditeur",
      "lastName": "Un",
      "email": "auditeur1@ministere.gouv",
      "credentials": [
        { "type": "password", "value": "Portail-Dev-2026!", "temporary": false }
      ],
      "realmRoles": ["AGENT", "AUDITEUR_PORTAIL"]
    }
  ]
}
