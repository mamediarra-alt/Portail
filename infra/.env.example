# =============================================================================
#  Portail Applicatif du Ministère — variables d'environnement (modèle)
#  Copier en .env (ignoré par Git) et renseigner des valeurs FORTES.
#  Ne jamais committer de secret. En production : coffre (Vault) ou secrets
#  d'orchestrateur, pas de fichier .env en clair.
# =============================================================================

# --- Base de données du portail (MySQL) ---
PORTAIL_DB_URL=jdbc:mysql://localhost:3306/portail_db?useSSL=true&requireSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
PORTAIL_DB_USER=portail_app
PORTAIL_DB_PASSWORD=__CHANGER__
PORTAIL_DB_MIGRATION_URL=jdbc:mysql://localhost:3306/portail_db?useSSL=true&serverTimezone=UTC
PORTAIL_DB_MIGRATION_USER=portail_migration
PORTAIL_DB_MIGRATION_PASSWORD=__CHANGER__

# --- Identité (Keycloak) ---
PORTAIL_OIDC_ISSUER_URI=https://auth.ministere.gouv/realms/ministere
PORTAIL_OIDC_AUDIENCE=portail-api
PORTAIL_BFF_CLIENT_ID=portail-bff
PORTAIL_BFF_CLIENT_SECRET=__CHANGER__

# --- Réseau interne ---
PORTAIL_API_PORT=8082
PORTAIL_BFF_PORT=8080
PORTAIL_API_URI=http://127.0.0.1:8082

# --- Keycloak (socle Docker local uniquement) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__CHANGER__
KC_DB_PASSWORD=__CHANGER__
